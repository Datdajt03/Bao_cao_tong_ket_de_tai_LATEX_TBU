% --- Quản lý Danh sách Sinh viên thực hiện ---
\newcounter{studentcount}
\setcounter{studentcount}{0}

\NewDocumentCommand{\addstudent}{ m G{} G{} }{%
  \stepcounter{studentcount}%
  \csdef{student@name@\thestudentcount}{#1}%
  \csdef{student@gender@\thestudentcount}{#2}%
  \csdef{student@ethnic@\thestudentcount}{#3}%
}

\newcommand{\addmember}[2]{\addstudent{#1}{}{}}
\newcommand{\clearcontentmembers}{%
  \setcounter{studentcount}{0}%
}

\newcounter{tbu@loopi}
\newcommand{\tbu@renderstudentitem}[1]{%
  \csuse{student@name@#1} &
  \ifcsvoid{student@gender@#1}{}{Nam, Nữ: \csuse{student@gender@#1}} &
  \ifcsvoid{student@ethnic@#1}{}{Dân tộc: \csuse{student@ethnic@#1}} \\
}

\newcommand{\renderstudentlist}{%
  \setcounter{tbu@loopi}{1}%
  \whiledo{\value{tbu@loopi} < \numexpr\value{studentcount}+1\relax}{%
    \expandafter\tbu@renderstudentitem\expandafter{\the\value{tbu@loopi}}%
    \stepcounter{tbu@loopi}%
  }%
}

% --- Khung bìa TikZ (Khung đôi nét đậm bên ngoài, nét mảnh bên trong chuẩn Bia_mau.pdf) ---
\newcommand{\drawcoverborder}{%
  \begin{tikzpicture}[remember picture, overlay]
    % Khung ngoài (nét đậm 2.0pt)
    \draw[line width=2.0pt] 
      ($(current page.north west) + (2.5cm,-1.5cm)$) 
      rectangle 
      ($(current page.south east) + (-1.2cm,1.5cm)$);
    % Khung trong (nét mảnh 0.7pt)
    \draw[line width=0.7pt] 
      ($(current page.north west) + (2.62cm,-1.62cm)$) 
      rectangle 
      ($(current page.south east) + (-1.32cm,1.62cm)$);
  \end{tikzpicture}%
}

% --- Lệnh tạo TRANG BÌA CHÍNH (Bìa ngoài - Page 1) ---
\newcommand{\makeoutercover}{%
  \begin{titlepage}
    \drawcoverborder
    \centering
    \setstretch{1.2}
    
    % Bộ & Trường
    {\fontsize{13pt}{16pt}\selectfont \tbu@ministry \par}
    \vspace{4pt}
    {\fontsize{14pt}{17pt}\selectfont \textbf{\tbu@university} \par}
    
    \vspace{1.2cm}
    
    % Logo trường
    \IfFileExists{\tbu@logo}{%
      \includegraphics[width=3.2cm, height=3.2cm, keepaspectratio]{\tbu@logo}\par
    }{%
      \vspace{3.2cm}
    }
    
    \vspace{1.2cm}
    
    % Loại báo cáo
    {\fontsize{14pt}{18pt}\selectfont \textbf{\tbu@reporttype} \par}
    \ifx\tbu@reportsubtype\@empty \else
      \vspace{4pt}
      {\fontsize{14pt}{18pt}\selectfont \textbf{\tbu@reportsubtype} \par}
    \fi
    
    \vspace{1.0cm}
    
    % Tên đề tài
    {\fontsize{15pt}{21pt}\selectfont \textbf{\MakeUppercase{\tbu@title}} \par}
    \ifx\tbu@subtitle\@empty \else
      \vspace{0.3cm}
      {\fontsize{13pt}{16pt}\selectfont \textit{\tbu@subtitle} \par}
    \fi
    
    \vspace{1.5cm}
    
    % Nhóm ngành khoa học
    \ifx\tbu@scientificfield\@empty \else
      {\fontsize{13pt}{16pt}\selectfont \textbf{Thuộc nhóm ngành khoa học: \tbu@scientificfield} \par}
    \fi
    
    \vfill
    
    % Địa điểm & Thời gian
    {\fontsize{13pt}{16pt}\selectfont \textbf{\tbu@location, \tbu@reportdate} \par}
    \vspace{0.8cm}
    
  \end{titlepage}
  \clearpage
}

% --- Lệnh tạo TRANG BÌA PHỤ (Page 2) ---
\newcommand{\makeinnercover}{%
  \begin{titlepage}
    \drawcoverborder
    \setstretch{1.12}
    
    \begin{center}
      % Bộ & Trường
      {\fontsize{13pt}{16pt}\selectfont \tbu@ministry \par}
      \vspace{3pt}
      {\fontsize{14pt}{17pt}\selectfont \textbf{\tbu@university} \par}
      
      \vspace{1.0cm}
      
      % Loại báo cáo
      {\fontsize{14pt}{18pt}\selectfont \textbf{\tbu@reporttype} \par}
      \ifx\tbu@reportsubtype\@empty \else
        \vspace{3pt}
        {\fontsize{14pt}{18pt}\selectfont \textbf{\tbu@reportsubtype} \par}
      \fi
      
      \vspace{0.5cm}
      
      % Tên đề tài
      {\fontsize{14pt}{19pt}\selectfont \textbf{\MakeUppercase{\tbu@title}} \par}
      \ifx\tbu@subtitle\@empty \else
        \vspace{0.2cm}
        {\fontsize{12pt}{15pt}\selectfont \textit{\tbu@subtitle} \par}
      \fi
      
      \vspace{0.6cm}
      
      % Nhóm ngành khoa học
      \ifx\tbu@scientificfield\@empty \else
        {\fontsize{12.5pt}{15pt}\selectfont \textbf{Thuộc nhóm ngành khoa học: \tbu@scientificfield} \par}
      \fi
    \end{center}
    
    \vspace{0.6cm}
    
    \begin{flushleft}
      \setstretch{1.15}
      {\fontsize{11.5pt}{14.5pt}\selectfont
        \noindent Sinh viên thực hiện:\par
        \vspace{0.12cm}
        \noindent\hspace*{1.0cm}%
        \begin{tabular}{@{} p{5.5cm} p{2.8cm} p{2.8cm} @{}}
          \renderstudentlist
        \end{tabular}\par
        \vspace{0.25cm}
        \noindent Lớp: \tbu@courseclass\par\vspace{2pt}
        \noindent Khoa: \tbu@faculty\par\vspace{2pt}
        \noindent Năm thứ: \tbu@academicyear\par\vspace{2pt}
        \noindent Ngành học: \tbu@major\par\vspace{2pt}
        \noindent Sinh viên chịu trách nhiệm chính: \textbf{\ifx\tbu@leadstudent\@empty \csuse{student@name@1}\else \tbu@leadstudent\fi}\par\vspace{2pt}
        \noindent Người hướng dẫn: \textbf{\tbu@advisor}\par
      }
    \end{flushleft}
    
    \vfill
    
    \begin{center}
      {\fontsize{13pt}{16pt}\selectfont \textbf{\tbu@location, \tbu@reportdate} \par}
      \vspace{0.6cm}
    \end{center}
    
  \end{titlepage}
  \clearpage
}

