% ==============================================================================
% tbu_report.sty - LaTeX Style Package cho Báo cáo / Khóa luận Trường ĐH Tây Bắc (TBU)
% Chuẩn hóa theo mẫu Báo cáo tổng kết Đề tài NCKH Sinh viên (Bia_mau.pdf)
% Phiên bản: 2.2 (2026)
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tbu_report}[2026/10/27 TBU Report Style Package v2.2]

% --- Các gói phụ thuộc cơ bản ---
\RequirePackage[utf8]{vietnam}
\RequirePackage{times}            % Phông chữ Times New Roman chuẩn
\RequirePackage[a4paper, top=20mm, bottom=20mm, left=30mm, right=15mm, footskip=8mm]{geometry}
\RequirePackage{setspace}         % Giãn dòng
\RequirePackage{graphicx}         % Chèn hình ảnh
\RequirePackage{tikz}             % Vẽ khung bìa
\usetikzlibrary{calc}
\RequirePackage{titlesec}         % Định dạng tiêu đề chương/mục
\RequirePackage{caption}          % Định dạng chú thích hình/bảng
\RequirePackage{fancyhdr}         % Định dạng trang header/footer
\RequirePackage{tocloft}          % Định dạng mục lục
\RequirePackage{array}            % Định dạng bảng
\RequirePackage{longtable}        % Bảng nhiều trang
\RequirePackage{booktabs}         % Đường kẻ bảng
\RequirePackage{enumitem}         % Danh sách liệt kê
\RequirePackage{indentfirst}      % Thụt đầu dòng đoạn văn đầu tiên
\RequirePackage{xparse}           % Hỗ trợ định nghĩa lệnh linh hoạt
\RequirePackage{etoolbox}         % Xử lý macro và danh sách sinh viên
\RequirePackage[hidelinks, unicode, pdfencoding=auto]{hyperref} % Liên kết PDF

% --- Cấu hình giãn dòng và khoảng cách đoạn ---
\setstretch{1.3}                 % Giãn dòng 1.3 chuẩn báo cáo
\setlength{\parindent}{1.0cm}     % Thụt đầu dòng 1cm
\setlength{\parskip}{3pt}         % Khoảng cách giữa các đoạn văn 3pt

% --- Cấu hình chú thích Hình ảnh và Bảng biểu ---
\captionsetup[figure]{name={Hình}, labelsep=colon, labelfont=bf, font=small, justification=centering}
\captionsetup[table]{name={Bảng}, labelsep=period, labelfont=bf, font=small, position=top, skip=6pt}

% --- Định dạng Trang Header / Footer ---
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage} % Số trang ở chính giữa phía dưới
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% --- Cấu hình Định dạng Tiêu đề Đồng bộ 12pt (Titlesec) ---
\titleformat{\chapter}[block]
  {\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries\raggedright}
  {\ifnum\c@secnumdepth >\m@ne CHƯƠNG \thechapter.\quad\fi}
  {0pt}
  {\fontsize{12pt}{14pt}\selectfont\bfseries}

\titlespacing*{\chapter}{0pt}{-24pt}{4pt}

\titleformat{\section}[block]
  {\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
  {\thesection.}
  {0.5em}
  {}

\titlespacing*{\section}{0pt}{4pt}{2pt}

\titleformat{\subsection}[block]
  {\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
  {\thesubsection.}
  {0.5em}
  {}

\titlespacing*{\subsection}{0pt}{3pt}{2pt}

\titleformat{\subsubsection}[block]
  {\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries\itshape}
  {\thesubsubsection.}
  {0.5em}
  {}

\titlespacing*{\subsubsection}{0pt}{2pt}{1pt}

% --- Định dạng phông chữ và căn giữa cho Mục lục (tocloft) ---
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftaftertoctitleskip}{12pt}
\setlength{\cftbeforechapskip}{4pt}
\setlength{\cftbeforesecskip}{1pt}
\setlength{\cftbeforesubsecskip}{0pt}

\renewcommand{\cfttoctitlefont}{\hfill\fontsize{14pt}{16pt}\selectfont\bfseries}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftchapfont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
\renewcommand{\cftchappagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont\bfseries}
\renewcommand{\cftsecfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftsecpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftsubsecfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftsubsecpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftchapleader}{\cftdotfill{\cftsecdotsep}}

% --- Cấu hình Danh mục Hình ảnh & Danh mục Bảng biểu (tocloft) ---
\renewcommand{\cftloftitlefont}{\hfill\fontsize{14pt}{16pt}\selectfont\bfseries}
\renewcommand{\cftafterloftitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\fontsize{14pt}{16pt}\selectfont\bfseries}
\renewcommand{\cftafterlottitle}{\hfill}
\setlength{\cftbeforeloftitleskip}{0pt}
\setlength{\cftafterloftitleskip}{12pt}
\setlength{\cftbeforelottitleskip}{0pt}
\setlength{\cftafterlottitleskip}{12pt}

\renewcommand{\cftfigfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cftfigpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cfttabfont}{\normalfont\fontsize{12pt}{14pt}\selectfont}
\renewcommand{\cfttabpagefont}{\normalfont\fontsize{12pt}{14pt}\selectfont}

\renewcommand{\cftfigpresnum}{Hình }
\renewcommand{\cfttabpresnum}{Bảng }
\settowidth{\cftfignumwidth}{Hình 9.9:\ }
\settowidth{\cfttabnumwidth}{Bảng 9.9:\ }
\renewcommand{\cftfigaftersnum}{:}
\renewcommand{\cfttabaftersnum}{.}

