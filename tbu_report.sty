% --- Lệnh tạo Chương không đánh số (Mở đầu, Kết luận...) ---
\newcommand{\unchapter}[1]{%
  \cleardoublepage
  \chapter*{#1}%
  \addcontentsline{toc}{chapter}{#1}%
}

% --- Lệnh tạo Mục trong Chương không đánh số (dùng cho MỞ ĐẦU: 1.1, 1.2...) ---
\newcommand{\unsection}[2]{%
  \section*{#1. #2}%
  \addcontentsline{toc}{section}{#1. #2}%
}

